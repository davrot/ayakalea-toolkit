#!/usr/bin/env bash
# View/tail service error logs (log level 50 / ERROR lines).
set -euo pipefail

source "$(dirname "$0")/../lib/toolkit-core.sh"

function usage() {
  echo "Usage: bin/error-logs [OPTIONS] [SERVICES...]"
  echo ""
  echo "Same service names and options as bin/logs; prints only error lines."
  echo ""
  echo "Options:"
  echo "  -f              follow log output"
  echo "  -n {number}     number of lines to print (default 20)"
  echo ""
  echo "Examples:"
  echo "  bin/error-logs -n 50 web clsi"
  echo "  bin/error-logs -f web"
  echo "  bin/error-logs -f"
}

function __main__() {
  if [[ "${1:-null}" == "help" || "${1:-null}" == "--help" ]]; then
    usage && exit
  fi
  # preserve the '==>' labels from tail output
  "$AYAKALEA_TOOLKIT_ROOT/bin/logs" "$@" | grep -E '(^==>.*$|^.*"level":50.*$|.*level=ERROR.*|.*ERROR.*)' --color=never
}

__main__ "$@"
