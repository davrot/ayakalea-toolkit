# =====================================================================
#  Ayakalea Toolkit — all container images in one place
#
#  This is the single resource file for every image name and version.
#  To upgrade a service: change its tag here, then run bin/up.
#  Check what is pulled locally with bin/images.
# =====================================================================

# Ayakalea application (default: ayaka-notes build)
# Community Edition alternative: docker.io/sharelatex/sharelatex:<tag>
AYAKALEA_IMAGE=ghcr.io/ayaka-notes/overleaf-pro:6.3.4

# MongoDB
MONGO_IMAGE=mongo:9.0

# Redis
REDIS_IMAGE=redis:8.10-alpine

# Git bridge (git clone / pull / push)
# Alternative: quay.io/sharelatex/git-bridge:<tag>
GIT_BRIDGE_IMAGE=ghcr.io/ayaka-notes/overleaf-pro/git-bridge:6.3.4

# nginx TLS proxy
NGINX_IMAGE=nginx:alpine3.24-slim

# SeaweedFS object storage (master, volume, filer, s3 all use this image)
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest

# TeX Live image for sandboxed compiles (2026)
# The toolkit derives TEX_LIVE_DOCKER_IMAGE and ALL_TEX_LIVE_DOCKER_IMAGES
# from this value; list additional images comma-separated to offer more
# compiler versions, e.g.
# TEXLIVE_IMAGE=ghcr.io/ayaka-notes/texlive-full:2026.1,ghcr.io/ayaka-notes/texlive-full:2025.1
TEXLIVE_IMAGE=ghcr.io/ayaka-notes/texlive-full:2026.1

# =====================================================================
#  Optional container sets (only pulled/built when enabled in overleaf.rc)
#  Source: ghcr.io/ayaka-notes/ where published; otherwise the public
#  upstream. bin/fetch-images pulls from the primary and falls back to
#  the *_FALLBACK ref or a local build (lib/images-build/).
# =====================================================================

# Language tool — real LanguageTool server (LANGUAGE_TOOL_ENABLED)
LANGUAGE_TOOL_IMAGE=ghcr.io/ayaka-notes/languagetool:1.default
LANGUAGE_TOOL_IMAGE_FALLBACK=erikvl87/languagetool:latest

# Language tool — grammar-llm LLM checker (GRAMMAR_LLM_ENABLED)
# No public fallback image: built from lib/images-build/grammar-llm
GRAMMAR_LLM_IMAGE=ghcr.io/ayaka-notes/grammar-llm:1.default

# Monitoring — instance-sensor exporter (MONITORING_ENABLED)
# No public fallback image: built from lib/images-build/instance-sensor
INSTANCE_SENSOR_IMAGE=ghcr.io/ayaka-notes/instance-sensor:1.default

# Monitoring — prometheus-probe-grafana public images (MONITORING_ENABLED)
PROMETHEUS_IMAGE=prom/prometheus:v2.53.5
GRAFANA_IMAGE=grafana/grafana-oss:11.6.0
MONGODB_EXPORTER_IMAGE=percona/mongodb_exporter:0.43.0
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.58.0-alpine
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
PROBE_IMAGE=busybox:1.36

# =====================================================================
#  Conversion bridge images — containers the app spawns itself (docker
#  socket) for pandoc / png2pdf / pdftocairo conversions. Names follow
#  the app's env vars (PANDOC_IMAGE, PNG2PDF_IMAGE, CONVERSION_SANDBOX_IMAGE).
#  Enable the app-side switches in config/variables.env
#  (ENABLE_PANDOC_CONVERSIONS / ENABLE_PNG2PDF_CONVERSIONS / CONVERTER).
# =====================================================================
PANDOC_IMAGE=ghcr.io/ayaka-notes/pandoc:1.default
# built from lib/images-build/pandoc if the registry pull is not possible
PDFTOCAIRO_IMAGE=ghcr.io/ayaka-notes/pdftocairo:24.02
PDFTOCAIRO_IMAGE_FALLBACK=sharelatex/pdftocairo:24.02
PNG2PDF_IMAGE=ghcr.io/ayaka-notes/png2pdf:2026-06-24
PNG2PDF_IMAGE_FALLBACK=sharelatex/png2pdf:2026-06-24
