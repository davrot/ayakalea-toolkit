# =====================================================================
#  Ayakalea Toolkit — application environment variables
#  Loaded into the ayakalea container (not into mongo/redis/git-bridge).
#  Docs: https://ayakaleaf-pro.ayaka.space/on-premises/configuration/overleaf-toolkit/environment-variables
#  Re-create containers after changes: bin/up
# =====================================================================

# -------------------------
#  Identity & branding
# -------------------------
OVERLEAF_APP_NAME="Ayakalea"
# OVERLEAF_SITE_URL=https://overleaf.example.com
# OVERLEAF_NAV_TITLE=Ayakalea
# OVERLEAF_ADMIN_EMAIL=support@example.com
# OVERLEAF_LOGIN_SUPPORT_TEXT="<a href=\"https://wiki.example.com\">Help</a>"
# OVERLEAF_HEADER_IMAGE_URL_LIGHT=http://somewhere.com/my-light-logo.png
# OVERLEAF_HEADER_IMAGE_URL_DARK=http://somewhere.com/my-dark-logo.png
# OVERLEAF_LEFT_FOOTER='[{"text":"Contact support","url":"mailto:support@example.com"}]'
# OVERLEAF_RIGHT_FOOTER='[{"text":"University of Example","url":"/"}]'
# OVERLEAF_CUSTOM_EMAIL_FOOTER=This system is run by department x
# OVERLEAF_STATUS_PAGE_URL=https://status.example.com
# OVERLEAF_MAINTENANCE_MESSAGE=Maintenance in progress
# OVERLEAF_MAINTENANCE_MESSAGE_HTML=...

# -------------------------
#  Secrets
# -------------------------
# Generated by bin/init. Keep with your backups.
OVERLEAF_INVITE_TOKEN_SECRET=
# Signs session cookies; without it every bin/up logs all users out.
OVERLEAF_SESSION_SECRET=
# GITHUB_TOKEN_CIPHER_PASSWORD=

# -------------------------
#  Authentication
#  Docs: https://ayakaleaf-pro.ayaka.space/on-premises/configuration/overleaf-toolkit/authentication
# -------------------------
EXTERNAL_AUTH=none
# OVERLEAF_ALLOW_PUBLIC_ACCESS=false
# OVERLEAF_ALLOW_PUBLIC_REGISTRATION=true
# OVERLEAF_RESTRICT_INVITES_TO_EXISTING_ACCOUNTS=false
# OVERLEAF_DISABLE_LOCAL_LOGIN=false
# OVERLEAF_DISABLE_LINK_SHARING=false

# OIDC (docs: .../authentication/oidc-authentication)
# EXTERNAL_AUTH=oidc
# OVERLEAF_OIDC_ISSUER=https://sso.example.com/realms/master
# OVERLEAF_OIDC_CLIENT_ID=ayakalea
# OVERLEAF_OIDC_CLIENT_SECRET=...
# OVERLEAF_OIDC_IDENTITY_SERVICE_NAME='Log in with SSO'
# OVERLEAF_OIDC_IS_ADMIN_FIELD=email
# OVERLEAF_OIDC_IS_ADMIN_FIELD_VALUE=admin@example.com
# OVERLEAF_OIDC_UPDATE_USER_DETAILS_ON_LOGIN=true

# SAML (docs: .../authentication/saml-authentication)
# EXTERNAL_AUTH=saml
# OVERLEAF_SAML_ENTRYPOINT=...
# OVERLEAF_SAML_IDP_CERT=...
# OVERLEAF_SAML_ISSUER=...
# OVERLEAF_SAML_EMAIL_FIELD=...

# LDAP (docs: .../authentication/ldap-authentication)
# EXTERNAL_AUTH=ldap
# OVERLEAF_LDAP_URL=ldap://ldap:389
# OVERLEAF_LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
# OVERLEAF_LDAP_SEARCH_FILTER=(uid={{username}})
# OVERLEAF_LDAP_BIND_DN=cn=admin,dc=example,dc=com
# OVERLEAF_LDAP_BIND_CREDENTIALS=...
# OVERLEAF_LDAP_EMAIL_ATT=mail
# OVERLEAF_LDAP_NAME_ATT=cn
# OVERLEAF_LDAP_UPDATE_USER_DETAILS_ON_LOGIN=true

# reCAPTCHA (docs: .../authentication/recaptcha)
# RECAPTCHA_SITE_KEY=...
# RECAPTCHA_SECRET_KEY=...

# Local password restrictions (docs: .../authentication/password-restrictions)
# OVERLEAF_PASSWORD_VALIDATION_MIN_LENGTH=8
# OVERLEAF_PASSWORD_VALIDATION_MAX_LENGTH=100
# HAVE_I_BEEN_PWNED_ENABLED=false

# -------------------------
#  Email delivery
#  Docs: https://ayakaleaf-pro.ayaka.space/on-premises/configuration/overleaf-toolkit/email-delivery
# -------------------------
# OVERLEAF_EMAIL_FROM_ADDRESS=ayakalea@example.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=
# OVERLEAF_EMAIL_SMTP_IGNORE_TLS=false
# OVERLEAF_EMAIL_SMTP_LOGGER=false
# Disables the "please confirm your email" banner
EMAIL_CONFIRMATION_DISABLED=true

# -------------------------
#  S3 storage (filestore + history)
#  Managed by the toolkit when SEAWEEDFS_ENABLED=true (overleaf.rc):
#  endpoints, keys and buckets are then derived automatically.
#  For an external S3 provider, disable SeaweedFS in overleaf.rc and set:
#  Docs: https://ayakaleaf-pro.ayaka.space/on-premises/configuration/overleaf-toolkit/s3
# -------------------------
# OVERLEAF_FILESTORE_USER_FILES_BUCKET_NAME=overleaf-user-files
# OVERLEAF_FILESTORE_TEMPLATE_FILES_BUCKET_NAME=overleaf-template-files
# OVERLEAF_FILESTORE_S3_ACCESS_KEY_ID=...
# OVERLEAF_FILESTORE_S3_SECRET_ACCESS_KEY=...
# OVERLEAF_FILESTORE_S3_ENDPOINT=https://s3.example.com
# OVERLEAF_FILESTORE_S3_PATH_STYLE=true
# OVERLEAF_FILESTORE_S3_REGION=us-east-1
# OVERLEAF_HISTORY_PROJECT_BLOBS_BUCKET=overleaf-project-blobs
# OVERLEAF_HISTORY_CHUNKS_BUCKET=overleaf-chunks
# OVERLEAF_HISTORY_S3_ACCESS_KEY_ID=...
# OVERLEAF_HISTORY_S3_SECRET_ACCESS_KEY=...
# OVERLEAF_HISTORY_S3_ENDPOINT=https://s3.example.com
# OVERLEAF_HISTORY_S3_PATH_STYLE=true
# OVERLEAF_HISTORY_S3_REGION=us-east-1

# S3 API credentials for the SeaweedFS service (generated by bin/init)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -------------------------
#  Sandboxed compiles
#  TeX Live image names live in config/images.env (TEXLIVE_IMAGE).
#  Docs: https://ayakaleaf-pro.ayaka.space/on-premises/configuration/overleaf-toolkit/sandboxed-compiles
# -------------------------
# TEX_COMPILER_EXTRA_FLAGS=-shell-escape
# TEXLIVE_IMAGE_USER=www-data
# COMPILE_TIMEOUT=599
# COMPILE_SIZE_LIMIT=50mb
# MAX_UPLOAD_SIZE=50
# DEFAULT_LATEX_COMPILER=pdflatex

# -------------------------
#  Linked files & integrations
#  Docs: https://ayakaleaf-pro.ayaka.space/on-premises/configuration/overleaf-toolkit/integrations
# -------------------------
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file,url
# ... add zotero,mendeley for reference managers, then:
# ZOTERO_CLIENT_KEY=...
# ZOTERO_CLIENT_SECRET=...
# MENDELEY_CLIENT_ID=...
# MENDELEY_CLIENT_SECRET=...
# MENDELEY_CALLBACK_URL=https://overleaf.example.com/user/mendeley/callback
# GITHUB_SYNC_CLIENT_ID=...
# GITHUB_SYNC_CLIENT_SECRET=...

# -------------------------
#  Templates
#  Docs: https://ayakaleaf-pro.ayaka.space/on-premises/configuration/overleaf-toolkit/templates
# -------------------------
# OVERLEAF_TEMPLATE_GALLERY=true
# OVERLEAF_NON_ADMIN_CAN_PUBLISH_TEMPLATES=false
# OVERLEAF_TEMPLATE_CATEGORIES=presentation thesis
# TEMPLATE_PRESENTATION_NAME=Presentations
# TEMPLATE_PRESENTATION_DESCRIPTION=Templates for Beamer and other presentation formats.
# TEMPLATE_THESIS_NAME=Theses
# TEMPLATE_THESIS_DESCRIPTION=Templates for writing theses and dissertations.

# -------------------------
#  Proxy / networking
#  When NGINX_ENABLED=true the toolkit sets OVERLEAF_SECURE_COOKIE and
#  OVERLEAF_TRUSTED_PROXY_IPS automatically (loopback,172.16.0.0/12).
#  Override explicitly if needed, e.g.
# OVERLEAF_TRUSTED_PROXY_IPS=loopback,172.16.0.0/12
# -------------------------
# Proxy for fetching external linked files
# OVERLEAF_LINKED_URL_OUTBOUND_PROXY=http://proxy.internal:3128

# -------------------------
#  Behaviour
# -------------------------
ENABLE_CONVERSIONS=true
# OVERLEAF_DISABLE_CHAT=false
# OVERLEAF_FPH_INITIALIZE_NEW_PROJECTS=false
# OVERLEAF_FPH_DISPLAY_NEW_PROJECTS=false
# Enable automatic clean-up of deleted projects/users (after 90 days)
# ENABLE_CRON_RESOURCE_DELETION=false
# OVERLEAF_USER_HARD_DELETION_DELAY=7776000000
# OVERLEAF_PROJECT_HARD_DELETION_DELAY=7776000000
# Localization (docs: .../configuration/overleaf-toolkit/localization)
# LANG=en
# OVERLEAF_SITE_LANGUAGE=en
